{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) WSL 外部终端运行/调试",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": true,  // 👈 核心属性：设为 true，弹到独立的外部终端运行
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整洁打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            // 注意：下面的名称必须和你 tasks.json 里的 "label" 保持完全一致！
            "preLaunchTask": "C/C++: g++ 生成活动文件"
        }
    ]
}